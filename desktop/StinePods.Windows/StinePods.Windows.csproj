<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>StinePods</AssemblyName>
    <RootNamespace>StinePods.Windows</RootNamespace>
    <!-- Everything must stay NativeAOT-compatible (docs/DECISIONS.md D2/D7): no built-in COM, no reflection JSON. -->
    <IsAotCompatible>true</IsAotCompatible>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <!-- Shown in Windows file properties and security prompts. -->
    <Product>StinePods</Product>
    <AssemblyTitle>StinePods</AssemblyTitle>
    <Description>Makes your Bluetooth headphones follow your audio between your phone and this PC</Description>
    <Company>stine</Company>
    <Copyright>Copyright © 2026 stine</Copyright>
    <Version>0.2.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StinePods.Core\StinePods.Core.csproj" />
  </ItemGroup>

</Project>
